# Frontend API origin. Use /api locally or the Render API URL in production.
VITE_API_URL="/api"

# Backend CORS allow-list. Comma-separated frontend origins.
# ALLOWED_ORIGINS="https://korhycodes.github.io"

# MongoDB Atlas connection settings for the backend.
# MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
# MONGODB_DB="sk-electricals"
# MONGODB_COLLECTION="submissions"

# Email notifications via Resend.
# RESEND_API_KEY="re_..."
# NOTIFICATION_EMAIL_TO="business@example.com"
# NOTIFICATION_FROM_EMAIL="SK Electricals <notifications@your-verified-domain.com>"

